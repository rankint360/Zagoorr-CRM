# Zagoorr production — copy to .env.local and fill in. Never commit real values.
# Database (Postgres via Neon or Supabase)
DATABASE_URL="postgresql://user:password@host:5432/zagoorr?sslmode=require"
# Auth / sessions — generate with: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
# App URLs (set per Vercel project / domain)
NEXT_PUBLIC_APP_URL="https://app.zagoorr.com"
NEXT_PUBLIC_PORTAL_URL="https://portal.zagoorr.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.zagoorr.com"
NEXT_PUBLIC_SITE_URL="https://zagoorr.com"
# Payments are ON HOLD (Decision 3) — no Stripe keys here on purpose.
# STRIPE_SECRET_KEY=""
# AI assists are label-only drafts in v1 — no live AI key required.
# OPENAI_API_KEY=""
